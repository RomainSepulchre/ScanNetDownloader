                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Progress..." VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Name="progrBarDownload" Minimum="0" Maximum="100" Margin="0 10 10 10"/>
                    </Grid>

                </Grid>-->
            </TabItem>
            
            <!--Options-->
            <TabItem Name="tabOptions" Height="60">
                <TabItem.Header>
                    <Border Margin="10 0 10 0">
                        <TextBlock Text="OPTIONS" FontSize="24" HorizontalAlignment="Center"/>
                    </Border>
                </TabItem.Header>
                <customControls:OptionsView x:Name="optionsVw"/> 
            </TabItem>

            <!--Debug-->
            <TabItem Name="tabDebug" Height="60"  >
                <TabItem.Header>
                    <Border Margin="10 0 10 0">
                        <TextBlock Text="DEBUG" FontSize="24" HorizontalAlignment="Center"/>
                    </Border>
                </TabItem.Header>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 20 0 0">
                    <Button Name="btnDbgSave" Content="Force Save Scan Data" Click="btnDbgSave_Click" Background="Orchid" Height="50" Width="200" Margin="10" FontSize="12"/>
                    <Button Name="btnDbgOpenDataJson" Content="Open Scan Data Json" Click="btnDbgOpenDataJson_Click"  Background="Orchid" Height="50" Width="200" Margin="10" FontSize="12"/>
                    <Button Name="btnDbgOpenSettingsJson" Content="Open Settings Json" Click="btnDbgOpenSettingsJson_Click"  Background="Orchid" Height="50" Width="200" Margin="10" FontSize="12"/>
                    <Button Name="btnDbg1" Content="Save html Files" Click="btnDbg1_Click" Width="200" Height="50" Margin="10" FontSize="12"/>
                    <Button Name="btnDbg2" Content="Test HttpClient" Width="200" Click="btnDbg2_Click" Height="50" Margin="10" FontSize="12"/>
                    <Button Name="btnDbg3" Content="Test Dl img" Width="200" Click="btnDbg3_Click" Height="50" Margin="10" FontSize="12"/>
                    <Button Name="btnDbg4" Content="AnimeSama VA test" Width="200" Click="btnDbg4_Click" Height="50" Margin="10" FontSize="12"/>
                    <Button Name="btnDbg5" Content="" Width="200" Click="btnDbg5_Click" Height="50" Margin="10" FontSize="12"/>
                    <Button Name="btnDbg6" Content="aaaaaa" Width="200" Click="btnDbg6_Click" Height="50" Margin="10" FontSize="12" Style="{StaticResource buttonWithStartImage}">
                    </Button>
                </WrapPanel>
            </TabItem>        
        </TabControl>

        <!--Status Bar-->
        <Grid Grid.Row="2" Background="DarkSlateBlue" Name="gridStatusBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="25"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Status...." Foreground="Aqua" VerticalAlignment="Center" Margin="10 0 0 0"/>
            <Button Grid.Column="1" Name="btnOpenStatusBar" Click="btnOpenStatusBar_Click" Content="^" Height="14" Width="14"/>
        </Grid>
        
    </Grid>
</Window>
