                        </ScrollViewer>

                        <GridSplitter Grid.Row="1" Height="3" Background="Black" VerticalAlignment="Top" HorizontalAlignment="Stretch" ShowsPreview="True" ResizeDirection="Rows"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" CanContentScroll="True">
                            <ItemsControl Name="stPanelDownloadInfo" ItemsSource="{Binding Source={StaticResource DownloadItemsSource}}">
                                    <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel IsItemsHost="True" Background="LightGray" Margin="5">
                                        </StackPanel>
                                    </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
