<Window x:Class="ScanNetDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScanNetDownloader"
        xmlns:customControls="clr-namespace:ScanNetDownloader.View.CustomControls"
        mc:Ignorable="d"
        Title="ScanNetDownloader" Height="720" Width="1280">
    <Window.Resources>
        <CollectionViewSource x:Key="ScanItemsSource" Source="{Binding ScanListItems}">
        </CollectionViewSource>
    </Window.Resources>
    <Grid x:Name="gridMainContent">

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        
        <TabControl Name="tabCtrlNavigation" SelectionChanged="tabCtrlNavigation_SelectionChanged" >
            
            <!--Scan Management-->
            <TabItem Name="tabMain" Header="Main">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>


                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10 10 10 0">
                        <!--<DataGrid Name="listVwScans" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding Source={StaticResource ScanItemsSource}, UpdateSourceTrigger=PropertyChanged}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Download" Binding="{Binding Path=IsSelectedForDownload}"/>
                                <DataGridTextColumn Header="BookName" Binding="{Binding Path=BookName}"/>
                                <DataGridTextColumn Header="Chapter" Binding="{Binding Path=ChapterId}"/>
                                <DataGridTextColumn Header="Number of Pages" Binding="{Binding Path=PagesCount}"/>
                                <DataGridTextColumn Header="Website" Binding="{Binding Path=Website}"/>
                                <DataGridTemplateColumn Header="Options">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                            --><!--<ListView ItemsSource="{Binding}"/>--><!--
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>-->
                        <ListView Name="listVwScans" ItemsSource="{Binding Source={StaticResource ScanItemsSource}, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Stretch">
                            <ListView.View>
                                <GridView AllowsColumnReorder="True">
                                    <GridViewColumn Header="Download">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Path=IsSelectedForDownload}" ToolTip="Select this scan for download"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Book Name" DisplayMemberBinding="{Binding Path=BookName}"/>
                                    <GridViewColumn Header="Chapter" DisplayMemberBinding="{Binding Path=ChapterId}"/>
                                    <GridViewColumn Header="Number of pages" DisplayMemberBinding="{Binding Path=PagesCount}"/>
                                    <GridViewColumn Header="Website" DisplayMemberBinding="{Binding Path=Website}"/>
                                    <GridViewColumn Header="Options">
                                        <!--I would love to understand why scanItem is displayed in this column and how to do it with a cell tempalate to make it more clear
                                        but I can't find how to assign the source scanItem as the template scanItem-->
                                    </GridViewColumn>
                                    <!--<GridViewColumn Header="Url" DisplayMemberBinding="{Binding Path=Url}"/>-->
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Name="btnAdd" Content="Add" Click="btnAdd_Click" Height="40" Width="100" Margin="5"/>
                        <Button Name="btnStart" Content="Start" Click="btnStart_Click" Height="40" Width="100" Margin="5"/>

                    </StackPanel>
                </Grid>
            </TabItem>
            
            <!--Scan Download-->
            <TabItem Name="tabDownload" Header="Download">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.9*"/>
                        <RowDefinition Height="0.1*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Name="scrollVwDownloadInfo"  VerticalScrollBarVisibility="Auto">
                        <TextBlock Name="txtBlockDownloadInfo" Text="{Binding DlInfo,UpdateSourceTrigger=PropertyChanged}"  Background="Aquamarine" Margin="5"/>
                    </ScrollViewer>
                    
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Progress..." VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Name="progrBarDownload" Minimum="0" Maximum="100" Margin="0 10 10 10"/>
                    </Grid>

                </Grid>
            </TabItem>
            
            <!--Options-->
            <TabItem Name="tabOptions" Header="Options">
                <customControls:OptionsView x:Name="optionsVw"/> 
            </TabItem>

            <!--Debug-->
            <TabItem Name="tabDebug" Header="Debug">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 20 0 0">
                    <Button Name="btnDbgSave" Content="Force Save Scan Data" Click="btnDbgSave_Click" Background="Orchid" Height="50" Width="200" Margin="10"/>
                    <Button Name="btnDbgOpenDataJson" Content="Open Scan Data Json" Click="btnDbgOpenDataJson_Click"  Background="Orchid" Height="50" Width="200" Margin="10"/>
                    <Button Name="btnDbgOpenSettingsJson" Content="Open Settings Json" Click="btnDbgOpenSettingsJson_Click"  Background="Orchid" Height="50" Width="200" Margin="10"/>
                    <Button Name="btnDbg1" Content="Save html Files" Click="btnDbg1_Click" Width="200" Height="50" Margin="10"/>
                    <Button Name="btnDbg2" Content="Test HttpClient" Width="200" Click="btnDbg2_Click" Height="50" Margin="10"/>
                    <Button Name="btnDbg3" Content="Test Dl img" Width="200" Click="btnDbg3_Click" Height="50" Margin="10"/>
                    <Button Name="btnDbg4" Content="AnimeSama VA test" Width="200" Click="btnDbg4_Click" Height="50" Margin="10"/>
                    <Button Name="btnDbg5" Content="" Width="200" Click="btnDbg5_Click" Height="50" Margin="10"/>
                    <Button Name="btnDbg6" Content="" Width="200" Click="btnDbg6_Click" Height="50" Margin="10"/>
                </WrapPanel>
            </TabItem>        
        </TabControl>

        <!--Status Bar-->
        <Grid Grid.Row="2" Background="DarkSlateBlue" Name="gridStatusBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="25"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Status...." Foreground="Aqua" VerticalAlignment="Center" Margin="10 0 0 0"/>
            <Button Grid.Column="1" Name="btnOpenStatusBar" Click="btnOpenStatusBar_Click" Content="^" Height="14" Width="14"/>
        </Grid>
        
    </Grid>
</Window>
