<Window x:Class="ScanNetDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScanNetDownloader"
        xmlns:customControls="clr-namespace:ScanNetDownloader.View.CustomControls"
        mc:Ignorable="d"
        Title="ScanNetDownloader" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        
        <TabControl Name="tabCtrlNavigation" SelectionChanged="tabCtrlNavigation_SelectionChanged">
            
            <!--Scan Management-->
            <TabItem Name="tabMain" Header="Main">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>


                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10 10 10 0">
                        <ListView Name="listVwScans" ItemsSource="{Binding ScanListItems, UpdateSourceTrigger=PropertyChanged}" Background="Beige" HorizontalContentAlignment="Stretch">

                        </ListView>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Name="btnAdd" Content="Add" Click="btnAdd_Click" Height="40" Width="100" Margin="5"/>
                        <Button Name="btnStart" Content="Start" Click="btnStart_Click" Height="40" Width="100" Margin="5"/>
                        <Button Name="btnDbgSave" Content="Debug_Save" Click="btnDbgSave_Click" Background="Orchid" Height="40" Width="100" Margin="5"/>
                        <Button Name="btnDbgOpenDataJson" Content="Debug_OpenJson" Click="btnDbgOpenDataJson_Click"  Background="Orchid" Height="40" Width="100" Margin="5"/>

                    </StackPanel>
                </Grid>
            </TabItem>
            
            <!--Scan Download-->
            <TabItem Name="tabDownload" Header="Download">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.9*"/>
                        <RowDefinition Height="0.1*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Name="scrollVwDownloadInfo"  VerticalScrollBarVisibility="Auto">
                        <TextBlock Name="txtBlockDownloadInfo" Text="{Binding DlInfo,UpdateSourceTrigger=PropertyChanged}"  Background="Aquamarine" Margin="5"/>
                    </ScrollViewer>
                    
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Progress..." VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Name="progrBarDownload" Minimum="0" Maximum="100" Margin="0 10 10 10"/>
                    </Grid>

                </Grid>
            </TabItem>
            
            <!--Options-->
            <TabItem Name="tabOptions" Header="Options">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.9*"/>
                        <RowDefinition Height="0.1*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Vertical" Margin="20">

                        <Label Content="General" FontWeight="Bold" Margin="0 0 0 0"/>

                        <StackPanel Orientation="Vertical" Margin="5 -5 0 0">
                            <Label Content="Download location" Margin=" -5 0 0 0" />
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 7">
                                <TextBox Name="txtBoxOutputDir" Text="X:/Files"  Width="400" Height="30" VerticalContentAlignment="Center"/>
                                <Button Name="btnChooseOutputDir" Content="Choose..." Click="btnChooseOutputDir_Click"  Width="80" Height="30" Margin="5 0 0 0"/>
                            </StackPanel>
                            <CheckBox Name="chBoxOpenOutputDir" Content="Open output directory after download" Margin="0 0 0 5"/>
                            <CheckBox Name="chBoxErrorPauseApp" Content="Error pause the download (Pop-up to acknowledge)" Margin="0 0 0 5"/>
                        </StackPanel>


                        <Label Content="Cbz Creation" FontWeight="Bold" Margin="0 8 0 5"/>
                        <StackPanel Orientation="Vertical" Margin="5 0 0 0">
                            <CheckBox Name="chBoxCreateCbz" Content="Create .Cbz archive after download" Margin="0 0 0 5"/>
                            <CheckBox Name="chBoxDeleteImageAfterCbz" Content="Delete scan image after .Cbz creation" Margin="0 0 0 5"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 0 70 0">
                        <Button Name="btnSaveOptions" Content="Save" Click="btnSaveOptions_Click" Width="80" Height="35" HorizontalAlignment="Right" Margin="0 0 10 0"/>
                        <Button Name="btnDbgOpenSettingsJson" Content="Debug_OpenJson" Click="btnDbgOpenSettingsJson_Click"  Background="Orchid" Height="35" Width="100" Margin="0 0 10 0"/>

                    </StackPanel>
                </Grid>
                
            </TabItem>
        </TabControl>

        <!--Status Bar-->
        <Grid Grid.Row="3" Background="DarkSlateBlue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="25"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Status...." Foreground="Aqua" VerticalAlignment="Center" Margin="10 0 0 0"/>
            <Button Grid.Column="1" Name="btnOpenStatusBar" Click="btnOpenStatusBar_Click" Content="^" Height="14" Width="14"/>
        </Grid>
        
    </Grid>
</Window>
