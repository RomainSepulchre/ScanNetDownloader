<Window x:Class="ScanNetDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScanNetDownloader"
        xmlns:customControls="clr-namespace:ScanNetDownloader.View.CustomControls"
        mc:Ignorable="d"
        Title="ScanNetDownloader" Height="450" Width="800">
    <Grid>
        <TabControl Name="MainTabs">
            <TabItem Header="Main">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="16"/>
                    </Grid.RowDefinitions>


                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10 10 10 0">
                        <ListView Name="scanListView" ItemsSource="{Binding ScanListItems, UpdateSourceTrigger=PropertyChanged}" Background="Beige" HorizontalContentAlignment="Stretch">

                        </ListView>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Name="btnAdd" Content="Add" Click="btnAdd_Click" Height="40" Width="100" Margin="5"/>
                        <Button Name="btnDbgSave" Content="Debug_Save" Click="btnDbgSave_Click" Background="Orchid" Height="40" Width="100" Margin="5"/>
                        <Button Name="btnOpenJSon" Content="Debug_OpenJson" Click="btnOpenJSon_Click"  Background="Orchid" Height="40" Width="100" Margin="5"/>
                        <Button Name="btnStart" Content="Start" Click="btnStart_Click" Height="40" Width="100" Margin="5"/>
                    </StackPanel>
                    <Rectangle Grid.Row="3" Fill="DarkSlateBlue"/>
                </Grid>
            </TabItem>
            <TabItem Header="Download">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.9*"/>
                        <RowDefinition Height="0.1*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Name="dlInfoScrollBar"  VerticalScrollBarVisibility="Auto">
                        <TextBlock Name="dlTxtBlock" Text="{Binding DlInfo,UpdateSourceTrigger=PropertyChanged}"  Background="Aquamarine" Margin="5"/>
                    </ScrollViewer>
                    
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="Progress..." VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Name="dlProgressBar" Minimum="0" Maximum="100" Margin="0 10 10 10"/>
                    </Grid>

                </Grid>
            </TabItem>
            <TabItem Header="Options">
            </TabItem>
        </TabControl>
        
        
    </Grid>
</Window>
