<Window x:Class="ScanNetDownloader.View.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScanNetDownloader.View"
        xmlns:customControls="clr-namespace:ScanNetDownloader.View.CustomControls"
        mc:Ignorable="d"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Title="Manage duplicated scan" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20 10 16 0">
            <TextBlock Text="Choose what to do with duplicate scan data" FontWeight="SemiBold" Foreground="{StaticResource Colors.Black}" FontSize="16"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20 13 20 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Name="btnIgnoreAll" Content="Delete all duplicate" Height="30" Width="150" Margin="0 0 5 0" Style="{StaticResource complexButton}"/>
                <Button Name="btnKeepAll" Content="Keep all duplicate" Height="30" Width="150" Margin="0 0 5 0" Style="{StaticResource complexButton}"/>
                <Button Name="btnReplaceAll" Content="Replace by duplicate (all)" Height="30" Width="180" Margin="0 0 5 0" Style="{StaticResource complexButton}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                <StackPanel Orientation="Vertical"  Margin="0 5 0 0" Background="{StaticResource Colors.LightGrey}">
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>
                    <customControls:DuplicateItem/>

                </StackPanel>
            </ScrollViewer>
            

            <!--<ListView Grid.Row="1" Margin="0 5 0 0" Background="{StaticResource Colors.LightGrey}" BorderThickness="0">
                
            </ListView>-->
        </Grid>


        <Grid Grid.Row="2">
            <Button Name="btnFinish" Content="Finish" Click="btnFinish_Click" FontSize="22"/>
        </Grid>

    </Grid>
</Window>
