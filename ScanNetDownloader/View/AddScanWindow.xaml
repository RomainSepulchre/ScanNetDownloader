<Window x:Class="ScanNetDownloader.View.AddScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScanNetDownloader.View"
        xmlns:customControls="clr-namespace:ScanNetDownloader.View.CustomControls"
        mc:Ignorable="d"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Title="Add a new scan" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Margin="20 8 16 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 2 0 0">
                <TextBlock Name="headerUrlView" Text="Add a new scan" FontWeight="SemiBold" Foreground="{StaticResource Colors.Black}" FontSize="16"/>
                <TextBlock Name="headerFirstSeparator" Text=">" Margin="10 0 10 0" FontWeight="SemiBold" Foreground="{StaticResource Colors.Black}" FontSize="16"/>
                <TextBlock Name="headerChapterView" Text="Select chapters" FontWeight="Light" Foreground="{StaticResource Colors.DarkGrey}" FontSize="16"/>
                <TextBlock Name="headerSecondSeparator" Text=">" Margin="10 0 10 0" FontWeight="Light" Foreground="{StaticResource Colors.DarkGrey}" FontSize="16"/>
                <TextBlock Name="headerScanDataCreationView" Text="Retrieve scan data" FontWeight="Light" Foreground="{StaticResource Colors.DarkGrey}" FontSize="16"/>
            </StackPanel>
            
            <Button Grid.Column="1" Name="btnClose" Click="btnClose_Click" Width="30" Height="30" Style="{StaticResource closeButton}">
                <Button.Content>
                    <Image Source="{StaticResource Img.crossWhite}"/>
                </Button.Content>
            </Button>
        </Grid>

        <customControls:UrlSelectionView Grid.Row="1" x:Name="urlSelectionVw" UrlConfirmed="urlSelectionVw_UrlConfirmed" Visibility="Visible"/>

        <customControls:ChaptersSelectionView Grid.Row="1" x:Name="chapterSelectionVw" BackBtnPressed="chapterSelectionVw_BackBtnPressed" ChaptersConfirmed="chapterSelectionVw_ChaptersConfirmed" Visibility="Collapsed"/>

        <customControls:ScanDataCreationView Grid.Row="1" x:Name="scanDataCreationVw" FinishBtnPressed="scanDataCreationVw_FinishBtnPressed" Visibility="Collapsed"/>
        
    </Grid>
</Window>
