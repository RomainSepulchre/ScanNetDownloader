<UserControl x:Class="ScanNetDownloader.View.CustomControls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="1280">
    
    <Grid Name="gridBar" MouseDown="gridBar_MouseDown" Background="{StaticResource Colors.Black}" Height="30">
       
        <!--Left of the title bar (icon and title)-->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Border Height="16" Width="16" Margin="8 0 5 0">
                <Image Source="{StaticResource Img.appIcon16}" >
                </Image>
            </Border>
            <TextBlock Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, FallbackValue=Window title}" Foreground="{StaticResource Colors.White}" VerticalAlignment="Center"/>
        </StackPanel>

        <!--Right of the title bar (Buttons)-->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

            <!--Minimize button-->
            <StackPanel Name="panelMinimize" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Rectangle Width="1" Fill="{StaticResource Colors.White}"/>
                <Button Name="btnMinimize" Click="btnMinimize_Click" Height="30" Width="30"  Style="{StaticResource complexButton}" Margin="0 0 0 0">
                    <Button.Content>
                        <Image Source="{StaticResource Img.minimizeIcon}"/>
                    </Button.Content>
                </Button>
            </StackPanel>

            <!--Maximize button-->
            <StackPanel Name="panelMaximize" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Rectangle Width="1" Fill="{StaticResource Colors.White}"/>
                <Button Name="btnMaximize" Click="btnMaximize_Click" Height="30" Width="30" Style="{StaticResource complexButton}" Margin="0 0 0 0">
                    <Button.Content>
                        <Image Name="imgMaximizeBtn" Source="{StaticResource Img.maximizeIcon}"/>
                    </Button.Content>
                </Button>
            </StackPanel>

            <!--Close button-->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Rectangle Width="1" Fill="{StaticResource Colors.White}"/>
                <Button Name="btnClose" Click="btnClose_Click" Height="30" Width="30" Style="{StaticResource blackCloseButton}" Margin="0 0 0 0">
                    <Button.Content>
                        <Image Source="{StaticResource Img.crossWhite}"/>
                    </Button.Content>
                </Button>
            </StackPanel>

        </StackPanel>
        
    </Grid>
</UserControl>
