<UserControl x:Class="ScanNetDownloader.View.CustomControls.DownloadItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="1200">
    <UserControl.Resources>
        <CollectionViewSource x:Key="DownloadEventItemsSource" Source="{Binding DownloadEventItems}">
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="0.35*"/>
            <ColumnDefinition Width="0.65*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Main Row-->
        <Button Name="btnShowDetails" Content="˅" Click="btnShowDetails_Click" Height="25" Width="25"/>

        <Border Grid.Column="1">
            <TextBlock Name="txtBlockItemHeader"  Text="Jujutsu Kaisen - Chapter 15 (10 pages)" VerticalAlignment="Center" Margin="5 0 0 0"/>
        </Border>

        <Grid Grid.Column="2" Name="gridDlStatus" Background="Orange">
            <ProgressBar Name="progrBarItemDownload" Minimum="0" Maximum="100" Height="20" Margin="10 0 10 0" Visibility="Collapsed"/>
            <Border Height="20" Margin="10 0 10 0">
                <TextBlock Name="txtBlockDlStatus" Text="Ready for download..." VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <!--Details-->
        <Border Name="downloadDetailsVw" Grid.Row="1" Grid.ColumnSpan="3" BorderThickness="0 0 0 5" BorderBrush="White" Visibility="Collapsed">
            <ItemsControl ItemsSource="{Binding Source={StaticResource DownloadEventItemsSource}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" IsItemsHost="True">
                        </StackPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
