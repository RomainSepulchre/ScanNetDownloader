<UserControl x:Class="ScanNetDownloader.View.CustomControls.DownloadItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="1240">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../MainResourcesDictionnary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <CollectionViewSource x:Key="DownloadEventItemsSource" Source="{Binding DownloadEventItems}">
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource Colors.LightGrey}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.52*"/>
            <ColumnDefinition Width="0.48*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3"/>
        </Grid.RowDefinitions>

        <!--Main Row-->
        <Border>
            <TextBlock Name="txtBlockItemHeader"  Text="Jujutsu Kaisen - Chapter 15 (10 pages)" VerticalAlignment="Center" Margin="20 0 0 0" FontWeight="SemiBold"/>
        </Border>

        <Grid Grid.Column="1" Name="gridDlStatus" Background="{StaticResource Colors.MediumGrey}">
            <ProgressBar Name="progrBarItemDownload" Minimum="0" Maximum="100" Height="18" Margin="10 0 10 0" Visibility="Collapsed"  Background="{StaticResource Colors.LightGrey}" Foreground="{StaticResource Colors.Green}" BorderThickness="0"/>
            <Border Height="18" Margin="10 0 10 1">
                <TextBlock Name="txtBlockDlStatus" Text="Ready for download..." VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <Button Grid.Column="2" Name="btnShowDetails" Click="btnShowDetails_Click" Height="30" Width="30" BorderThickness="0" Background="{StaticResource Colors.Black}">
            <Button.Content>
                <Image Source="{StaticResource Img.moreDetailsClosed}"/>
            </Button.Content>
        </Button>

        <!--Details-->
        <Border Name="downloadDetailsVw" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed"  Margin="0 0 0 5">
            <ItemsControl ItemsSource="{Binding Source={StaticResource DownloadEventItemsSource}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" IsItemsHost="True">
                        </StackPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Fill="{StaticResource Colors.White}"/>
    </Grid>
</UserControl>
