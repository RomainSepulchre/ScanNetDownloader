<UserControl x:Class="ScanNetDownloader.View.CustomControls.DownloadItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="1200">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="0.4*"/>
            <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Main Row-->
        <Button Name="btnShowDetails" Content="˅" Click="btnShowDetails_Click"/>

        <StackPanel Orientation="Horizontal" Grid.Column="1">
            <Border>
                <TextBlock Name="txtBlockItemHeader"  Text="Jujutsu Kaisen - Chapter 15 (10 pages)" VerticalAlignment="Center" Margin="5 0 0 0"/>
            </Border>
        </StackPanel>

        <Grid Name="gridDlStatus" Grid.Column="2" Background="Orange">
            <Border Height="20" Margin="10 0 10 0">
                <TextBlock Name="txtBlockDlStatus" Text="Ready for download..." VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Background="Blue" Visibility="Collapsed">
            <ProgressBar Height="20" Margin="10 0 10 0"/>
            <Border Height="20" Margin="10 0 10 0">
                <TextBlock Text="Downloading..." VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
        
        <!--Details-->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Name="stPanelDetails" Orientation="Vertical" Background="Aqua" Visibility="Collapsed">
        </StackPanel>
    </Grid>
</UserControl>
