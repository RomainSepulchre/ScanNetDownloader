<UserControl x:Class="ScanNetDownloader.View.CustomControls.ChapterItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="250">
    <Border Background="{StaticResource Colors.White}" Height="30" Width="100" Margin="0 0 0 5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ChapterText}" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold"/>
            <Button Grid.Column="1" Name="btnDelete" Style="{StaticResource complexButton}" Click="btnDelete_Click">
                <Button.Content>
                    <Image Source="{StaticResource Img.crossWhite}"/>
                </Button.Content>
            </Button>
        </Grid>
    </Border>
    
</UserControl>
