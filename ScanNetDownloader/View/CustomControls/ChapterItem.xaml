<UserControl x:Class="ScanNetDownloader.View.CustomControls.ChapterItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="250">
    <Border Background="White" BorderBrush="DimGray" BorderThickness="2" Height="25" Width="100">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="25"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ChapterText}" VerticalAlignment="Center" TextAlignment="Center"/>
            <Button Grid.Column="1" Name="btnDelete" Content="X" Click="btnDelete_Click"/>
        </Grid>
    </Border>
    
</UserControl>
