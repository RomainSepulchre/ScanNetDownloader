<UserControl x:Class="ScanNetDownloader.View.CustomControls.WebsiteUrlWithExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="4" Height="4" Fill="{StaticResource Colors.Black}" Margin="0 2 2 0"/>
                <TextBlock>
                    <Span xml:space="preserve"><Run Text="{Binding WebsiteUrl, FallbackValue=https://www.example.net}" FontWeight="Bold"></Run> <Run>(</Run><Hyperlink Click="Hyperlink_Click"><TextBlock Text="{Binding LinkText, FallbackValue=Show examples}"/></Hyperlink><Run>)</Run></Span>
                </TextBlock>
            </StackPanel>

            <ItemsControl Name="stPanelExamples" ItemsSource="{Binding ExampleUrlTxtBlocks}" >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Margin="6 0 0 0">
                        </StackPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
