<UserControl x:Class="ScanNetDownloader.View.CustomControls.DuplicateItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="760">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="2" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="gridBookInfo">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="imgSeeCurrent"  Source="{StaticResource Img.questionBlack}" Width="18" Height="18" MouseEnter="imgSeeCurrent_MouseEnter" MouseLeave="imgSeeCurrent_MouseLeave"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Book name - chapter 999 (99 pages)" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5 0 0 0"/>
                    <TextBlock Text="https://anime-sama.fr" VerticalAlignment="Center" FontStyle="Italic" Margin="10 0 0 0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" x:Name="stPanelCurrentData" Orientation="Horizontal" Background="Aqua" Visibility="Collapsed">
                    <TextBlock Text="Current data: " VerticalAlignment="Center" FontStyle="Italic" Margin="5 0 0 0"/>
                    <TextBlock Text="Book name - chapter 999 (99 pages)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text="https://anime-sama.fr" VerticalAlignment="Center" FontStyle="Italic" Margin="10 0 0 0"/>
                </StackPanel>

            </Grid>

            <ComboBox Grid.Column="1" x:Name="cbDuplicateOptions" Width="Auto" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0 0 10 0">
                <ComboBoxItem>Delete duplicate</ComboBoxItem>
                <ComboBoxItem>Keep duplicate</ComboBoxItem>
                <ComboBoxItem>Replace current by duplicate</ComboBoxItem>
            </ComboBox>
            
        </Grid>
        



        <Rectangle Grid.Row="1" Fill="{StaticResource Colors.White}"/>
    </Grid>
</UserControl>
