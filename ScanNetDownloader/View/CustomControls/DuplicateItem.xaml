<UserControl x:Class="ScanNetDownloader.View.CustomControls.DuplicateItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="760">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="2" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25" />
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <Image Name="imgSeeCurrent"  Source="{StaticResource Img.questionBlack}" Width="18" Height="18" MouseEnter="imgSeeCurrent_MouseEnter" MouseLeave="imgSeeCurrent_MouseLeave"/>

            <Rectangle Grid.Column="1" Name="labelRect" Fill="{StaticResource Colors.Orange}" Height="20"/>
            <TextBlock Grid.Column="1" Name="txtBlockLabel" Text="{Binding ItemLabel, FallbackValue=Duplicate}" VerticalAlignment="Center" HorizontalAlignment="Center" FontStyle="Italic"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Vertical" Margin="5 0 0 0">
                <TextBlock Text="{Binding DuplicateScanInfo, FallbackValue=Book name - Chapter 999 (99 pages)}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5 0 0 0"/>
                <TextBlock Text="{Binding DuplicateScanUrl, FallbackValue=https://some-url.fr}" VerticalAlignment="Center" FontSize="10" FontStyle="Italic" Margin="5 0 0 0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="2" x:Name="stPanelCurrentData" VerticalAlignment="Center" Orientation="Vertical" Margin="5 0 0 0" Background="{StaticResource Colors.MediumGrey}" Visibility="Hidden">
                <TextBlock Text="{Binding CurrentScanInfo, FallbackValue=Book name - Chapter 999 (99 pages)}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5 10 0 0"/>
                <TextBlock Text="{Binding CurrentScanUrl, FallbackValue=https://some-url.fr}" VerticalAlignment="Center" FontSize="10" FontStyle="Italic" Margin="5 0 0 10" TextWrapping="Wrap"/>
            </StackPanel>


            <ComboBox Grid.Column="3" Name="cbDuplicateOptions" SelectionChanged="cbDuplicateOptions_SelectionChanged" Width="Auto" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0 0 10 0">
                <ComboBoxItem>Delete duplicate</ComboBoxItem>
                <ComboBoxItem>Keep duplicate</ComboBoxItem>
                <ComboBoxItem>Replace current by duplicate</ComboBoxItem>
            </ComboBox>
            
        </Grid>
        
        <Rectangle Grid.Row="1" Fill="{StaticResource Colors.White}"/>
    </Grid>
</UserControl>
