<UserControl x:Class="ScanNetDownloader.View.CustomControls.ScanItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="190">
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 -2 0 2">
            <Button Name="btnCbzCreation" Content="Create .CBZ" FontWeight="Normal" ToolTip="Is the cbz archive created ?" Click="btnCbzCreation_Click" Width="80" Height="20"  FontSize="12"  Margin="0 0 0 0" Style="{StaticResource complexButton}">
            </Button>
            
            <Button Name="btnDelete" Click="btnDelete_Click" ToolTip="Delete scan from list" Height="20" Width="20" FontSize="9"  Margin="10 0 0 0" Style="{StaticResource closeButton}">
                <Button.Content>
                    <Image Source="{StaticResource Img.crossWhite}" Height="20" Width="20"/>
                </Button.Content>
            </Button>

            <Button x:Name="btnDebug" Content="🐛" Click="btnDebug_Click" Height="20" Width="20" Margin="10 0 0 0"/>
        </StackPanel>

    </Grid>
</UserControl>
