<UserControl x:Class="ScanNetDownloader.View.CustomControls.ScanItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="65"/>
        </Grid.ColumnDefinitions>
        <CheckBox Name="MustDownloadCheckbox" IsChecked="{Binding IsSelectedForDownload, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Rectangle Grid.Column="1" Fill="#333333"/>
        <Label Grid.Column="2" Name="bookNameLb" Content="BookName" VerticalAlignment="Center"/>
        <Rectangle Grid.Column="3" Fill="#333333"/>
        <Label Grid.Column="4" Name="chapterNumberLb" Content="Chapter" VerticalAlignment="Center"/>
        <Rectangle Grid.Column="5" Fill="#333333"/>
        <Label Grid.Column="6" Name="websiteLb" Content="Website" VerticalAlignment="Center"/>
        <Rectangle Grid.Column="7" Fill="#333333"/>
        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="?" Height="15" Width="15" FontSize="9" Margin="3 0 3 0"/>
            <Button Content="📁" Height="15" Width="15" FontSize="9"  Margin="3 0 3 0"/>
            <Button Content="X" Height="15" Width="15" FontSize="9"  Margin="3 0 3 0"/>
        </StackPanel>
    </Grid>
</UserControl>
