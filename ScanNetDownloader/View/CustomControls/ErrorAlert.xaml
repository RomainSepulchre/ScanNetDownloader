<UserControl x:Class="ScanNetDownloader.View.CustomControls.ErrorAlert"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="800"
             x:Name="userControl">
    <Grid DataContext="{Binding ElementName=userControl}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Image Source="{StaticResource Img.error}" Height="22" Width="22"/>
        <TextBlock Grid.Column="1" Text="{Binding ErrorMsg}" Foreground="{StaticResource Colors.Red}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
