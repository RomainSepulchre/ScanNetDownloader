<UserControl x:Class="ScanNetDownloader.View.CustomControls.DownloadEventItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScanNetDownloader.View.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="1200">
    <Grid>
        <Border Height="20" Background="{Binding BackgroundColor}" BorderThickness="0 1 0 0" BorderBrush="Transparent" Margin="10 0 0 0">
            <TextBlock Text="{Binding MsgText}"  VerticalAlignment="Center" Margin="8 0 0 0"/>
        </Border>
    </Grid>
</UserControl>
