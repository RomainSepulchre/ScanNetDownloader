    <BitmapImage x:Key="Img.plusIconBlack" UriSource="/Images/plusIcon_Black.png"></BitmapImage>
    <BitmapImage x:Key="Img.startIconWhite" UriSource="/Images/startIcon_White.png"></BitmapImage>
    <BitmapImage x:Key="Img.startIconBlack" UriSource="/Images/startIcon_Black.png"></BitmapImage>
    <BitmapImage x:Key="Img.startIconBlue" UriSource="/Images/startIcon_Blue.png"></BitmapImage>
