    <BitmapImage x:Key="Img.crossWhite" UriSource="/Images/crossIcon_White.png"></BitmapImage>
    <BitmapImage x:Key="Img.questionBlack" UriSource="/Images/questionIcon_Black.png"></BitmapImage>
    <BitmapImage x:Key="Img.infoIcon" UriSource="/Images/infoIcon.png"></BitmapImage>
    <BitmapImage x:Key="Img.warningIcon" UriSource="/Images/warningIcon.png"></BitmapImage>
    <BitmapImage x:Key="Img.downloadWhite" UriSource="/Images/downloadIcon_White.png"></BitmapImage>
    <BitmapImage x:Key="Img.downloadGrey" UriSource="/Images/downloadIcon_Grey.png"></BitmapImage>
    <BitmapImage x:Key="Img.downloadBlack" UriSource="/Images/downloadIcon_Black.png"></BitmapImage>
    <BitmapImage x:Key="Img.downloadOrange" UriSource="/Images/downloadIcon_Orange.png"></BitmapImage>
    <BitmapImage x:Key="Img.downloadBorderBlack" UriSource="/Images/downloadIcon_BorderBlack.png"></BitmapImage>
    <BitmapImage x:Key="Img.minimizeIcon" UriSource="/Images/minimizeIcon.png"></BitmapImage>
