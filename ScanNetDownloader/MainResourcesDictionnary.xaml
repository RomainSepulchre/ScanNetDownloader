    <BitmapImage x:Key="Img.moreDetailsClosed" UriSource="/Images/moreDetailsIcon_Closed.png"></BitmapImage>
    <BitmapImage x:Key="Img.moreDetailsOppened" UriSource="/Images/moreDetailsIcon_Oppened.png"></BitmapImage>
    <BitmapImage x:Key="Img.checkboxWhiteEmpty" UriSource="/Images/checkboxIcon_White_Empty.png"></BitmapImage>
    <BitmapImage x:Key="Img.checkboxBlackEmpty" UriSource="/Images/checkboxIcon_Black_Empty.png"></BitmapImage>
