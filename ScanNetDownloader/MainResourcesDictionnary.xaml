    <!--Example - Button simple changes (No trigger)-->
    <Style TargetType="Button" x:Key="Example.simpleButton">
        <Setter Property="Background" Value="{StaticResource Colors.Black}"/>
        <Setter Property="Foreground" Value="{StaticResource Colors.White}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!--Example - Button advanced changes (Trigger)-->
    <Style TargetType="Button" x:Key="Example.buttonWithTrigger">
        <Setter Property="Background" Value="{StaticResource Colors.Black}"/>
        <Setter Property="Foreground" Value="{StaticResource Colors.White}"/>
