    <!--Border between every colums-->
    <Style x:Key="GridViewColumnHeaderGripper" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Background" Value="{StaticResource GridView.Gripper.ColumnSeparation}"/>
        <Setter Property="Template">
            <Setter.Value>
