<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    
    <!--Colors-->
    
    <Color x:Key="BaseColor.Black" R="0" G="0" B="0" A="255"/>
    <Color x:Key="BaseColor.White" R="255" G="255" B="255" A="255"/>
    <Color x:Key="BaseColor.LightGrey" R="239" G="239" B="239" A="255"/>
    <Color x:Key="BaseColor.MediumGrey" R="204" G="204" B="204" A="255"/>
    <Color x:Key="BaseColor.Blue" R="32" G="164" B="252" A="255"/>
    <Color x:Key="BaseColor.DarkBlue" R="40" G="32" B="64" A="255"/>
    <Color x:Key="BaseColor.Red" R="252" G="62" B="62" A="255"/>
    <Color x:Key="BaseColor.Orange" R="241" G="178" B="85" A="255"/>
    <Color x:Key="BaseColor.Green" R="16" G="188" B="119" A="255"/>
    
    <SolidColorBrush x:Key="Colors.Black" Color="{StaticResource BaseColor.Black}"/>
    <SolidColorBrush x:Key="Colors.White" Color="{StaticResource BaseColor.White}"/>
    <SolidColorBrush x:Key="Colors.LightGrey" Color="{StaticResource BaseColor.LightGrey}"/>
    <SolidColorBrush x:Key="Colors.MediumGrey" Color="{StaticResource BaseColor.MediumGrey}"/>
    <SolidColorBrush x:Key="Colors.Blue" Color="{StaticResource BaseColor.Blue}"/>
    <SolidColorBrush x:Key="Colors.DarkBlue" Color="{StaticResource BaseColor.DarkBlue}"/>
    <SolidColorBrush x:Key="Colors.Red" Color="{StaticResource BaseColor.Red}"/>
    <SolidColorBrush x:Key="Colors.Orange" Color="{StaticResource BaseColor.Orange}"/>
    <SolidColorBrush x:Key="Colors.Green" Color="{StaticResource BaseColor.Green}"/>



    <!--Images-->
    <BitmapImage x:Key="Img.plusIconWhite" UriSource="/Images/plusIcon_White.png"></BitmapImage>
    <BitmapImage x:Key="Img.plusIconBlack" UriSource="/Images/plusIcon_Black.png"></BitmapImage>
    <BitmapImage x:Key="Img.startIconWhite" UriSource="/Images/startIcon_White.png"></BitmapImage>
    <BitmapImage x:Key="Img.startIconBlack" UriSource="/Images/startIcon_Black.png"></BitmapImage>
    <BitmapImage x:Key="Img.startIconBlue" UriSource="/Images/startIcon_Blue.png"></BitmapImage>
    <BitmapImage x:Key="Img.stopIcon" UriSource="/Images/stopIcon.png"></BitmapImage>
    <BitmapImage x:Key="Img.moreDetailsClosed" UriSource="/Images/moreDetailsIcon_Closed.png"></BitmapImage>
    <BitmapImage x:Key="Img.moreDetailsOppened" UriSource="/Images/moreDetailsIcon_Oppened.png"></BitmapImage>
    <BitmapImage x:Key="Img.checkboxWhiteEmpty" UriSource="/Images/checkboxIcon_White_Empty.png"></BitmapImage>
    <BitmapImage x:Key="Img.checkboxBlackEmpty" UriSource="/Images/checkboxIcon_Black_Empty.png"></BitmapImage>

    <ImageBrush x:Key="ImgBrush.StartNormal" ImageSource="{StaticResource Img.startIconWhite}"/>
    <ImageBrush x:Key="ImgBrush.StartHover" ImageSource="{StaticResource Img.startIconBlue}"/>

    <!--Syles-->

    <!--Default Button - Based on original button template-->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <!--<Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>-->
                    <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{StaticResource Colors.White}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <SolidColorBrush x:Key="Button.Static.Background" Color="{StaticResource BaseColor.Black}"/>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
    <SolidColorBrush x:Key="Button.Static.Foreground" Color="{StaticResource BaseColor.White}"/>
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="{StaticResource BaseColor.DarkBlue}"/>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>
    <SolidColorBrush x:Key="Button.MouseOver.Foreground" Color="{StaticResource BaseColor.Blue}"/>
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6"/>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B"/>
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>
    
    <Style TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
        <!--<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>-->
        <Setter Property="Foreground" Value="{StaticResource Button.Static.Foreground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                        <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Button.IsDefaulted" Value="true">
                            <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource Button.MouseOver.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border}"/>
                            <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.MouseOver.Foreground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Pressed.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                            <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="startButton" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
        <!--<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>-->
        <Setter Property="Foreground" Value="{StaticResource Button.Static.Foreground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="-2 0 0 0">
                            <Border x:Name="img" Width="{TemplateBinding Height}" Background="{StaticResource ImgBrush.StartNormal}" Margin="0 0 2 0"/>
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Button.IsDefaulted" Value="true">
                            <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource Button.MouseOver.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border}"/>
                            <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.MouseOver.Foreground}"/>
                            <Setter Property="Background" TargetName="img" Value="{StaticResource ImgBrush.StartHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Pressed.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                            <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Example - Button simple changes (No trigger)-->
    <Style TargetType="Button" x:Key="Example.simpleButton">
        <Setter Property="Background" Value="{StaticResource Colors.Black}"/>
        <Setter Property="Foreground" Value="{StaticResource Colors.White}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!--Example - Button advanced changes (Trigger)-->
    <Style TargetType="Button" x:Key="Example.buttonWithTrigger">
        <Setter Property="Background" Value="{StaticResource Colors.Black}"/>
        <Setter Property="Foreground" Value="{StaticResource Colors.White}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Colors.DarkBlue}"/>
                <Setter Property="Foreground" Value="{StaticResource Colors.Blue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--TEST-->
    <Style TargetType="Button" x:Key="TESTBTN">
        <Setter Property="Background" Value="{StaticResource Colors.Orange}"/>
        <Setter Property="Foreground" Value="{StaticResource Colors.White}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bordertest" Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border x:Name="imgBorder" Height="30" Width="30" Background="{StaticResource ImgBrush.StartNormal}" BorderBrush="Azure"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="bordertest" Value="{StaticResource Colors.DarkBlue}"/>
                            <Setter Property="Foreground" Value="{StaticResource Colors.Blue}"/>
                            <Setter Property="Background" TargetName="imgBorder" Value="{StaticResource ImgBrush.StartHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>